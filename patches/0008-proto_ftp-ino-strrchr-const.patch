# proto_ftp.ino: cast strrchr() result before assigning to char*.
# In C++ strrchr(const char*, int) returns const char*; FTPHost::fixPath() takes
# a "const char *remotepath" and assigns straight into "char *end" (then writes
# *end = 0). GCC accepts the implicit const-drop with a warning under
# -fpermissive; Clang makes it a hard error. Explicit cast matches the style
# already used throughout this file, e.g. strchr((char *)vbuf, ...). No
# behaviour change (callers pass writable buffers, as before).
# ximodem patch against Zimodem @ a24225cc1b6c219e6c0764a4e6b1a388356a1dd5
--- a/proto_ftp.ino	2026-09-02 18:06:29.669307519 -0400
+++ b/proto_ftp.ino	2026-09-02 18:06:29.679002930 -0400
@@ -65,7 +65,7 @@
 {
   if(remotepath == 0)
     return;
-  char *end = strrchr(remotepath, '/');
+  char *end = (char *)strrchr(remotepath, '/');   /* ximodem: C++ strrchr(const char*) -> const char* */
   int buflen = ((path == 0) ? 0 : strlen(path)) + strlen(remotepath) + 3;
   char fbuf[buflen];
   char pbuf[buflen];
